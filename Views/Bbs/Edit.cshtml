@model BbsPost
@{
    ViewData["Title"] = "게시글 수정";
}

<div class="form-heading">
    <p class="eyebrow">EDIT POST</p>
    <h1>게시글 수정</h1>
</div>
<form asp-action="Edit" asp-route-id="@Model.ID" method="post" enctype="multipart/form-data" class="post-form">
    @Html.AntiForgeryToken()
    <input asp-for="ID" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <p class="signed-user">작성자: @Context.Session.GetString("UserName")</p>
    <label asp-for="Title"></label>
    <input asp-for="Title" class="form-control" autofocus />
    <span asp-validation-for="Title" class="text-danger"></span>
    <label asp-for="Contents"></label>
    <textarea asp-for="Contents" class="form-control content-input" rows="12"></textarea>
    <span asp-validation-for="Contents" class="text-danger"></span>
    <label for="upload">새 첨부파일</label>
    <input id="upload" name="upload" type="file" class="form-control" />
    @if (!string.IsNullOrWhiteSpace(Model.File))
    {
        <p class="current-file">현재 파일: @Model.File</p>
    }
    <div class="form-actions">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ID">취소</a>
        <button class="btn btn-primary" type="submit">저장하기</button>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
