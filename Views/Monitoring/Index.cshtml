@model AspNetBbs.Models.SystemMetricsViewModel
@{
    ViewData["Title"] = "시스템 모니터링";
}

<div class="monitor-container">
    <div class="monitor-header">
        <div>
            <h1 class="monitor-title">시스템 모니터링</h1>
            <p class="monitor-subtitle">서버의 CPU 및 RAM 리소스 사용 현황을 실시간으로 확인합니다.</p>
        </div>
        <div class="monitor-controls">
            <div class="live-status">
                <span class="live-dot" id="liveDot"></span>
                <span class="live-text" id="liveStatusText">실시간 수집 중</span>
            </div>
            <div class="control-group">
                <select id="refreshInterval" class="form-select form-select-sm" title="갱신 주기">
                    <option value="1000">1초 주기</option>
                    <option value="2000" selected>2초 주기</option>
                    <option value="5000">5초 주기</option>
                    <option value="0">일시 정지</option>
                </select>
                <button id="btnManualRefresh" class="btn btn-sm btn-outline-secondary" type="button">
                    새로고침
                </button>
            </div>
            <span class="text-muted small" id="lastUpdatedText">마지막 갱신: @Model.Timestamp</span>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="row g-3 mb-4">
        <!-- CPU Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card monitor-card h-100">
                <div class="card-body">
                    <div class="card-label-row">
                        <span class="card-label">CPU 사용률</span>
                        <span id="cpuBadge" class="badge bg-success">정상</span>
                    </div>
                    <div class="metric-value-row">
                        <span class="metric-value" id="cpuValue">@Model.CpuUsagePercent</span>
                        <span class="metric-unit">%</span>
                    </div>
                    <div class="progress monitor-progress">
                        <div id="cpuProgressBar" class="progress-bar bg-info" role="progressbar" 
                             style="width: @Model.CpuUsagePercent%" 
                             aria-valuenow="@Model.CpuUsagePercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="metric-detail-list">
                        <div class="metric-detail-item">
                            <span>프로세스(웹앱) CPU</span>
                            <strong id="procCpuValue">@Model.ProcessCpuUsagePercent %</strong>
                        </div>
                        <div class="metric-detail-item">
                            <span>논리 프로세서 코어</span>
                            <span>@Model.CpuCoreCount 코어</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RAM Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card monitor-card h-100">
                <div class="card-body">
                    <div class="card-label-row">
                        <span class="card-label">RAM 사용률</span>
                        <span id="ramBadge" class="badge bg-success">정상</span>
                    </div>
                    <div class="metric-value-row">
                        <span class="metric-value" id="ramValue">@Model.MemoryUsagePercent</span>
                        <span class="metric-unit">%</span>
                    </div>
                    <div class="progress monitor-progress">
                        <div id="ramProgressBar" class="progress-bar bg-primary" role="progressbar" 
                             style="width: @Model.MemoryUsagePercent%" 
                             aria-valuenow="@Model.MemoryUsagePercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="metric-detail-list">
                        <div class="metric-detail-item">
                            <span>사용 / 전체 메모리</span>
                            <strong id="ramUsageDetail">@Model.UsedMemoryFormatted / @Model.TotalMemoryFormatted</strong>
                        </div>
                        <div class="metric-detail-item">
                            <span>사용 가능 메모리</span>
                            <span id="ramAvailValue">@Model.AvailableMemoryFormatted</span>
                        </div>
                        <div class="metric-detail-item">
                            <span>프로세스(웹앱) 메모리</span>
                            <strong id="procMemValue">@Model.ProcessMemoryFormatted</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System & Process Info Card -->
        <div class="col-md-12 col-lg-4">
            <div class="card monitor-card h-100">
                <div class="card-body">
                    <div class="card-label-row">
                        <span class="card-label">서버 및 인스턴스 정보</span>
                        <span class="badge bg-secondary">System</span>
                    </div>
                    <div class="metric-info-list">
                        <div class="metric-info-item">
                            <span class="info-label">호스트명</span>
                            <span class="info-val text-truncate" title="@Model.MachineName">@Model.MachineName</span>
                        </div>
                        <div class="metric-info-item">
                            <span class="info-label">OS</span>
                            <span class="info-val text-truncate" title="@Model.OsDescription">@Model.OsDescription</span>
                        </div>
                        <div class="metric-info-item">
                            <span class="info-label">시스템 가동시간</span>
                            <span class="info-val" id="sysUptimeValue">@Model.SystemUptime</span>
                        </div>
                        <div class="metric-info-item">
                            <span class="info-label">앱 가동시간</span>
                            <span class="info-val" id="procUptimeValue">@Model.ProcessUptime</span>
                        </div>
                        <div class="metric-info-item">
                            <span class="info-label">스레드 / GC 힙</span>
                            <span class="info-val"><span id="threadCountValue">@Model.ThreadCount</span>개 / <span id="gcMemValue">@Model.GcMemoryFormatted</span></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Real-time Chart Section -->
    <div class="card monitor-card mb-4">
        <div class="card-body">
            <div class="chart-header">
                <div>
                    <h5 class="chart-title">실시간 리소스 사용률 추이 (최근 60초)</h5>
                    <span class="chart-desc">CPU 및 메모리 변동 내역을 실시간으로 시각화합니다.</span>
                </div>
                <div class="chart-legend">
                    <span class="legend-item"><span class="legend-box legend-cpu"></span> CPU (%)</span>
                    <span class="legend-item"><span class="legend-box legend-ram"></span> RAM (%)</span>
                </div>
            </div>
            <div class="chart-canvas-container">
                <canvas id="metricsChart" height="240"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const maxPoints = 30;
    const historyData = {
        labels: [],
        cpu: [@Model.CpuUsagePercent],
        ram: [@Model.MemoryUsagePercent]
    };

    // Initialize labels
    const initialTime = new Date().toLocaleTimeString('ko-KR', { hour12: false });
    historyData.labels.push(initialTime);

    let refreshTimer = null;
    let intervalMs = 2000;

    const elCpuValue = document.getElementById('cpuValue');
    const elCpuProgressBar = document.getElementById('cpuProgressBar');
    const elCpuBadge = document.getElementById('cpuBadge');
    const elProcCpuValue = document.getElementById('procCpuValue');

    const elRamValue = document.getElementById('ramValue');
    const elRamProgressBar = document.getElementById('ramProgressBar');
    const elRamBadge = document.getElementById('ramBadge');
    const elRamUsageDetail = document.getElementById('ramUsageDetail');
    const elRamAvailValue = document.getElementById('ramAvailValue');
    const elProcMemValue = document.getElementById('procMemValue');

    const elSysUptime = document.getElementById('sysUptimeValue');
    const elProcUptime = document.getElementById('procUptimeValue');
    const elThreadCount = document.getElementById('threadCountValue');
    const elGcMem = document.getElementById('gcMemValue');
    const elLastUpdated = document.getElementById('lastUpdatedText');

    const elLiveDot = document.getElementById('liveDot');
    const elLiveStatusText = document.getElementById('liveStatusText');
    const elRefreshInterval = document.getElementById('refreshInterval');
    const elBtnManualRefresh = document.getElementById('btnManualRefresh');
    const canvas = document.getElementById('metricsChart');
    const ctx = canvas.getContext('2d');

    function updateBadge(badge, value) {
        if (value >= 85) {
            badge.className = 'badge bg-danger';
            badge.textContent = '위험';
        } else if (value >= 60) {
            badge.className = 'badge bg-warning text-dark';
            badge.textContent = '주의';
        } else {
            badge.className = 'badge bg-success';
            badge.textContent = '정상';
        }
    }

    function updateProgressColor(bar, value, baseClass) {
        bar.style.width = Math.min(100, Math.max(0, value)) + '%';
        bar.setAttribute('aria-valuenow', value);
        if (value >= 85) {
            bar.className = 'progress-bar bg-danger';
        } else if (value >= 60) {
            bar.className = 'progress-bar bg-warning';
        } else {
            bar.className = 'progress-bar ' + baseClass;
        }
    }

    function renderMetrics(data) {
        // CPU
        elCpuValue.textContent = data.cpuUsagePercent.toFixed(1);
        updateBadge(elCpuBadge, data.cpuUsagePercent);
        updateProgressColor(elCpuProgressBar, data.cpuUsagePercent, 'bg-info');
        elProcCpuValue.textContent = data.processCpuUsagePercent.toFixed(1) + ' %';

        // RAM
        elRamValue.textContent = data.memoryUsagePercent.toFixed(1);
        updateBadge(elRamBadge, data.memoryUsagePercent);
        updateProgressColor(elRamProgressBar, data.memoryUsagePercent, 'bg-primary');
        elRamUsageDetail.textContent = data.usedMemoryFormatted + ' / ' + data.totalMemoryFormatted;
        elRamAvailValue.textContent = data.availableMemoryFormatted;
        elProcMemValue.textContent = data.processMemoryFormatted;

        // Info
        elSysUptime.textContent = data.systemUptime;
        elProcUptime.textContent = data.processUptime;
        elThreadCount.textContent = data.threadCount;
        elGcMem.textContent = data.gcMemoryFormatted;
        elLastUpdated.textContent = '마지막 갱신: ' + data.timestamp;

        // Add to history
        const nowStr = new Date().toLocaleTimeString('ko-KR', { hour12: false });
        historyData.labels.push(nowStr);
        historyData.cpu.push(data.cpuUsagePercent);
        historyData.ram.push(data.memoryUsagePercent);

        if (historyData.cpu.length > maxPoints) {
            historyData.labels.shift();
            historyData.cpu.shift();
            historyData.ram.shift();
        }

        drawChart();
    }

    async function fetchMetrics() {
        try {
            const resp = await fetch('/Monitoring/GetMetrics', { credentials: 'same-origin' });
            if (!resp.ok) return;
            const data = await resp.json();
            renderMetrics(data);
        } catch (err) {
            console.error('Failed to fetch metrics:', err);
        }
    }

    // Canvas Chart Rendering
    function drawChart() {
        const dpr = window.devicePixelRatio || 1;
        const rect = canvas.getBoundingClientRect();
        
        if (canvas.width !== rect.width * dpr || canvas.height !== rect.height * dpr) {
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
        }

        ctx.save();
        ctx.scale(dpr, dpr);

        const width = rect.width;
        const height = rect.height;

        ctx.clearRect(0, 0, width, height);

        const padding = { top: 20, right: 25, bottom: 35, left: 40 };
        const plotWidth = width - padding.left - padding.right;
        const plotHeight = height - padding.top - padding.bottom;

        // Background Grid & Y-Axis (0%, 25%, 50%, 75%, 100%)
        ctx.strokeStyle = '#e9ecef';
        ctx.lineWidth = 1;
        ctx.fillStyle = '#6c757d';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'right';

        for (let i = 0; i <= 4; i++) {
            const yVal = i * 25;
            const y = padding.top + plotHeight - (plotHeight * (yVal / 100));
            ctx.beginPath();
            ctx.moveTo(padding.left, y);
            ctx.lineTo(width - padding.right, y);
            ctx.stroke();

            ctx.fillText(yVal + '%', padding.left - 8, y + 4);
        }

        // Draw Line Function
        function drawSeries(points, strokeColor, fillColor) {
            if (points.length === 0) return;

            const step = points.length > 1 ? plotWidth / (maxPoints - 1) : 0;
            const startX = width - padding.right - (points.length - 1) * step;

            // Fill area
            ctx.beginPath();
            for (let i = 0; i < points.length; i++) {
                const x = startX + i * step;
                const y = padding.top + plotHeight - (plotHeight * (Math.min(100, Math.max(0, points[i])) / 100));
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            const lastX = startX + (points.length - 1) * step;
            ctx.lineTo(lastX, padding.top + plotHeight);
            ctx.lineTo(startX, padding.top + plotHeight);
            ctx.closePath();
            ctx.fillStyle = fillColor;
            ctx.fill();

            // Stroke line
            ctx.beginPath();
            for (let i = 0; i < points.length; i++) {
                const x = startX + i * step;
                const y = padding.top + plotHeight - (plotHeight * (Math.min(100, Math.max(0, points[i])) / 100));
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = strokeColor;
            ctx.lineWidth = 2.2;
            ctx.lineJoin = 'round';
            ctx.stroke();

            // Last point highlight dot
            if (points.length > 0) {
                const lastY = padding.top + plotHeight - (plotHeight * (Math.min(100, Math.max(0, points[points.length - 1])) / 100));
                ctx.beginPath();
                ctx.arc(lastX, lastY, 4, 0, Math.PI * 2);
                ctx.fillStyle = strokeColor;
                ctx.fill();
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 1.5;
                ctx.stroke();
            }
        }

        // Draw RAM first, then CPU
        drawSeries(historyData.ram, '#2b6cb0', 'rgba(43, 108, 176, 0.12)');
        drawSeries(historyData.cpu, '#0c7c86', 'rgba(12, 124, 134, 0.15)');

        // X-Axis labels (start, middle, end)
        ctx.fillStyle = '#6c757d';
        ctx.textAlign = 'center';
        if (historyData.labels.length > 0) {
            const firstIdx = 0;
            const midIdx = Math.floor(historyData.labels.length / 2);
            const lastIdx = historyData.labels.length - 1;

            const step = historyData.labels.length > 1 ? plotWidth / (maxPoints - 1) : 0;
            const startX = width - padding.right - (historyData.labels.length - 1) * step;

            ctx.fillText(historyData.labels[firstIdx], startX, height - 12);
            if (midIdx !== firstIdx && midIdx !== lastIdx) {
                ctx.fillText(historyData.labels[midIdx], startX + midIdx * step, height - 12);
            }
            ctx.fillText(historyData.labels[lastIdx], startX + lastIdx * step, height - 12);
        }

        ctx.restore();
    }

    function setupTimer() {
        if (refreshTimer) {
            clearInterval(refreshTimer);
            refreshTimer = null;
        }

        if (intervalMs > 0) {
            elLiveDot.className = 'live-dot active';
            elLiveStatusText.textContent = '실시간 수집 중';
            refreshTimer = setInterval(fetchMetrics, intervalMs);
        } else {
            elLiveDot.className = 'live-dot paused';
            elLiveStatusText.textContent = '일시 정지됨';
        }
    }

    elRefreshInterval.addEventListener('change', (e) => {
        intervalMs = parseInt(e.target.value, 10);
        setupTimer();
    });

    elBtnManualRefresh.addEventListener('click', () => {
        fetchMetrics();
    });

    window.addEventListener('resize', () => {
        drawChart();
    });

    // Initial setup
    updateBadge(elCpuBadge, @Model.CpuUsagePercent);
    updateBadge(elRamBadge, @Model.MemoryUsagePercent);
    drawChart();
    setupTimer();
})();
</script>
}

