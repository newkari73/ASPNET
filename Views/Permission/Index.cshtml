@model AspNetBbs.Models.PermissionManageViewModel
@{
    ViewData["Title"] = "메뉴 권한 관리";
    var selectedMember = Model.SelectedMember;
}

<div class="container-fluid py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 mb-1">메뉴별 사용자 권한 관리</h2>
            <p class="text-muted small mb-0">사용자별로 각 메뉴(게시판, 일정관리, 모니터링)의 읽기, 수정, 삭제 권한을 설정합니다.</p>
        </div>
    </div>

    <div class="row g-3">
        <!-- 사용자 목록 (좌측) -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold small">사용자 목록 (@Model.Members.Count)</span>
                </div>
                <div class="list-group list-group-flush" style="max-height: 600px; overflow-y: auto;">
                    @foreach (var member in Model.Members)
                    {
                        var isSelected = member.UserID.Equals(selectedMember?.UserID, StringComparison.OrdinalIgnoreCase);
                        <a asp-action="Index" asp-route-selectedUserId="@member.UserID"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isSelected ? "active" : "")">
                            <div>
                                <div class="fw-semibold">@member.UserName</div>
                                <small class="@(isSelected ? "text-light" : "text-muted")">@member.UserID</small>
                            </div>
                            @if (member.IsAdmin)
                            {
                                <span class="badge @(isSelected ? "bg-light text-dark" : "bg-danger")">관리자</span>
                            }
                            else
                            {
                                <span class="badge @(isSelected ? "bg-light text-primary" : "bg-secondary")">회원</span>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- 메뉴별 권한 설정 (우측) -->
        <div class="col-md-8 col-lg-9">
            <div class="card shadow-sm">
                @if (selectedMember is not null)
                {
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fs-5 fw-bold text-primary">@selectedMember.UserName</span>
                            <span class="text-muted ms-1">(@selectedMember.UserID)</span>
                            @if (selectedMember.IsAdmin)
                            {
                                <span class="badge bg-danger ms-2">시스템 관리자 (모든 권한 보유)</span>
                            }
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1" id="btnCheckAll">전체 권한 부여</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnUncheckAll">전체 권한 회수</button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (selectedMember.IsAdmin)
                        {
                            <div class="alert alert-warning py-2 mb-3 small">
                                <strong>안내:</strong> 관리자 계정은 시스템 최고 권한자로서 설정과 무관하게 모든 메뉴에 대해 읽기, 수정, 삭제 권한이 기본 보장됩니다.
                            </div>
                        }

                        <form asp-action="Save" method="post" id="permissionForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="UserID" value="@selectedMember.UserID" />

                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-4">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 25%;">메뉴명</th>
                                            <th style="width: 25%; text-align: center;">읽기 (조회)</th>
                                            <th style="width: 25%; text-align: center;">수정 (등록/수정)</th>
                                            <th style="width: 25%; text-align: center;">삭제</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < selectedMember.Permissions.Count; i++)
                                        {
                                            var perm = selectedMember.Permissions[i];
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="Permissions[@i].MenuCode" value="@perm.MenuCode" />
                                                    <span class="fw-bold">@perm.MenuName</span>
                                                    <div class="text-muted small">@perm.MenuCode</div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check form-switch d-inline-block">
                                                        <input class="form-check-input perm-read" type="checkbox"
                                                               id="perm_read_@i"
                                                               name="Permissions[@i].CanRead"
                                                               value="true"
                                                               @(perm.CanRead ? "checked" : "")
                                                               data-index="@i" />
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check form-switch d-inline-block">
                                                        <input class="form-check-input perm-update" type="checkbox"
                                                               id="perm_update_@i"
                                                               name="Permissions[@i].CanUpdate"
                                                               value="true"
                                                               @(perm.CanUpdate ? "checked" : "")
                                                               data-index="@i" />
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check form-switch d-inline-block">
                                                        <input class="form-check-input perm-delete" type="checkbox"
                                                               id="perm_delete_@i"
                                                               name="Permissions[@i].CanDelete"
                                                               value="true"
                                                               @(perm.CanDelete ? "checked" : "")
                                                               data-index="@i" />
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-save"></i> 권한 저장
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="card-body text-center py-5 text-muted">
                        사용자가 존재하지 않습니다.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnCheckAll = document.getElementById('btnCheckAll');
            const btnUncheckAll = document.getElementById('btnUncheckAll');
            const checkboxes = document.querySelectorAll('#permissionForm input[type="checkbox"]');

            if (btnCheckAll) {
                btnCheckAll.addEventListener('click', function () {
                    checkboxes.forEach(cb => cb.checked = true);
                });
            }

            if (btnUncheckAll) {
                btnUncheckAll.addEventListener('click', function () {
                    checkboxes.forEach(cb => cb.checked = false);
                });
            }

            // 읽기 권한을 해제하면 수정/삭제도 자동 해제
            document.querySelectorAll('.perm-read').forEach(readCb => {
                readCb.addEventListener('change', function () {
                    const idx = this.getAttribute('data-index');
                    if (!this.checked) {
                        const updateCb = document.getElementById('perm_update_' + idx);
                        const deleteCb = document.getElementById('perm_delete_' + idx);
                        if (updateCb) updateCb.checked = false;
                        if (deleteCb) deleteCb.checked = false;
                    }
                });
            });

            // 수정 또는 삭제 권한을 체크하면 읽기 권한도 자동 체크
            document.querySelectorAll('.perm-update, .perm-delete').forEach(actionCb => {
                actionCb.addEventListener('change', function () {
                    const idx = this.getAttribute('data-index');
                    if (this.checked) {
                        const readCb = document.getElementById('perm_read_' + idx);
                        if (readCb) readCb.checked = true;
                    }
                });
            });
        });
    </script>
}