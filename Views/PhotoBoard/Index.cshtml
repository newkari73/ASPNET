@model BbsPageViewModel
@{
    ViewData["Title"] = "사진게시판";
}

<section class="photo-board-header">
    <div>
        <p class="eyebrow">PHOTO GALLERY</p>
        <h1>사진게시판</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">사진 올리기</a>
</section>

<div class="photo-gallery-grid">
    @if (Model.Posts.Count == 0)
    {
        <div class="empty-state" style="grid-column: 1 / -1;">등록된 사진이 없습니다.</div>
    }
    else
    {
        foreach (var post in Model.Posts)
        {
            <article class="photo-card">
                <a asp-action="Details" asp-route-id="@post.ID" class="photo-card-image">
                    @if (post.HasAttachment)
                    {
                        <img src="@Url.Content(post.PrimaryImagePath)" alt="@post.Title" />
                    }
                    else
                    {
                        <div class="photo-empty">이미지 없음</div>
                    }
                </a>
                <div class="photo-card-body">
                    <h3><a asp-action="Details" asp-route-id="@post.ID">@post.Title</a></h3>
                    <div class="photo-card-meta">
                        <span>@post.UserName</span>
                        <span>@post.RegDate.ToString("yyyy.MM.dd")</span>
                        @if (post.ImageFiles.Count > 1)
                        {
                            <span>+@((post.ImageFiles.Count - 1))장</span>
                        }
                    </div>
                </div>
            </article>
        }
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="pagination-nav" aria-label="사진게시판 페이지 이동">
        @if (Model.HasPreviousBlock)
        {
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.StartPage - 1)" aria-label="이전 10페이지">&laquo;</a>
        }

        @if (Model.CurrentPage > 1)
        {
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" aria-label="이전 페이지">&lsaquo;</a>
        }

        @for (var pageNum = Model.StartPage; pageNum <= Model.EndPage; pageNum++)
        {
            <a class="page-link @(pageNum == Model.CurrentPage ? "active" : "")" asp-action="Index" asp-route-page="@pageNum">@pageNum</a>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" aria-label="다음 페이지">&rsaquo;</a>
        }

        @if (Model.HasNextBlock)
        {
            <a class="page-link" asp-action="Index" asp-route-page="@(Model.EndPage + 1)" aria-label="다음 10페이지">&raquo;</a>
        }
    </nav>
}
